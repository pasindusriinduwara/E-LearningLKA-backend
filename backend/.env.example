# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database Configuration (Optional override)
# DB_URL=jdbc:postgresql://localhost:5432/tuition_lms
# DB_USERNAME=postgres
# DB_PASSWORD=your_password

# JWT Configuration (Optional override)
# JWT_SECRET_KEY=your_jwt_secret_key_here

# Authentication rate limits (per backend instance; direct peer IP, not X-Forwarded-For)
# AUTH_LOGIN_IP_LIMIT=100
# AUTH_LOGIN_WINDOW_SECONDS=60
# AUTH_LOGIN_ACCOUNT_LIMIT=10
# AUTH_LOGIN_ACCOUNT_WINDOW_SECONDS=900
# AUTH_REGISTER_IP_LIMIT=10
# AUTH_REGISTER_ACCOUNT_LIMIT=3
# AUTH_REGISTER_WINDOW_SECONDS=600
# AUTH_RATE_LIMIT_MAX_ENTRIES=10000
